namespace Program;

extern infargs int printf(ref byte ptr);

class Item
{
	private int Hidden;

	public int Open;

	public ctor(int value)
	{
		Hidden = value;
		Open = 0;
	}

	private int GetHidden()
	{
		return Hidden;
	}

	public int Combine()
	{
		// private поле + private метод доступны изнутри класса.
		return GetHidden() + Open;
	}
}

class OtherClass
{
	public refo Item PublicItem = new Item(-1);

	public ctor()
	{
	}

	public int ReadOpen()
	{
		return PublicItem.Open;
	}
}

int main()
{
	own Item item = val Item(5);
	item.Open = 10;

	// Public-поле доступно извне.
	printf(ref "%d\n", item.Open);

	// Private-поле и private-метод доступны внутри через public-метод.
	printf(ref "%d\n", item.Combine());

	// Доступ к public-полю из другого класса.
	refo Item heapItem = new Item(2);
	heapItem.Open = 10;
	own OtherClass other = val OtherClass();
	refo Item oldPublicItem;
	refo oldPublicItem = other.PublicItem <- heapItem;
	printf(ref "%d\n", other.ReadOpen());

	// Public-поле другого экземпляра того же класса.
	own Item item2 = val Item(1);
	item2.Open = 3;
	item.Open = item2.Open + item.Open;
	printf(ref "%d\n", item.Open);

	return 0;
}
