namespace Program;

extern infargs int printf(refb byte ptr);
extern infargs int scanf(refb byte ptr);

int main()
{
	int num = 0;
    scanf(refb "%d", loc num);

	num = num + 1;
	printf(refb "%d\n", num);

	int[10][5] arr;

	int i = 0;
	while (i < 10) 
	{
		int j = 0;
		while (j < 5)
		{
			arr[i][j] = num + i + j;
			j = j + 1;
		}
		i = i + 1;
	}

	refb int cell = loc arr[5][4];
	printf(refb "%d\n", cell);

	refb int cell2 = loc arr[5];
	printf(refb "%d\n", cell2);

	refb int[5] innerArrayRef = loc arr[7];

	i = 0;
	while (i < 5) 
	{
		printf(refb "%d\n", innerArrayRef[i]);
		i = i + 1;
	}

	cell = cell + cell;

	printf(refb "%d\n", arr[5][4]);
	
	return 0;
}