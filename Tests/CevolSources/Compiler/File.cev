namespace System;

extern refo int fopen(ref byte fileName, ref byte mode);
extern long fwrite(ref byte buffer, long size, long count, ref int filePointer);

class File
{
    private refo int _filePointer;

    public ctor(ref byte fileName, ref byte mode)
    {
        refo _filePointer = fopen(ref fileName, ref mode);
    }

    public void Write(ref byte buffer, long count)
    {
        fwrite(ref buffer, 1, count, ref _filePointer);
    }
}