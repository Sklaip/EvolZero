namespace System;

extern ref int fopen(refb byte fileName, refb byte mode);
extern long fwrite(refb byte buffer, long size, long count, refb int filePointer);

class File
{
    private ref int _filePointer;

    public ctor(refb byte fileName, refb byte mode)
    {
        ref _filePointer = fopen(refb fileName, refb mode);
    }

    public void Write(refb byte buffer, long count)
    {
        fwrite(refb buffer, 1, count, refb _filePointer);
    }
}