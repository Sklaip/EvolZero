namespace Program;

using System;

extern infargs int printf(refb byte ptr);

class Connect
{
	public int ConnType;
	public bool Available;

	public ctor(int startConnType)
	{
		ConnType = startConnType;
	}

	public int SetConnectType(int type)
	{
		ConnType = ConnType + type;
		return 1;
	}

	public void PrintConnectType()
	{
		ref String str = new String();
		printf(refb str.ToBytes(), ConnType);
	}
}

class Provider
{
	public refb Connect ServiveConnect;
	public bool Available;
	public int Count;

	public ctor(refb Connect serviceConnect) lifetimes (serviceConnect ~ this)
	{
		refb ServiveConnect = serviceConnect;
	}

	public refb int SetServiveConnect(int type) lifetimes (return ~ this)
	{
		ServiveConnect.ConnType = type;
		Count = type + 11;
		return loc Count;
	}

	public int WriteConnType(refb int toWrite)
	{
		toWrite = ServiveConnect.ConnType;
		toWrite = toWrite - 5;
		return 2;
	}
}

int Tests()
{
	ref String serviceStr = new String();

	ref Connect connect = new Connect(17);

	connect.SetConnectType(10);
	connect.PrintConnectType();

	ref Connect baseConnect = new Connect(0);
	ref Provider provider = new Provider(refb baseConnect);
	refb provider.ServiveConnect = connect;

	refb int serviceConnet = provider.SetServiveConnect(412);
	connect.PrintConnectType();
	provider.ServiveConnect.PrintConnectType();
	printf(refb serviceStr.ToBytes(), provider.Count);
	printf(refb serviceStr.ToBytes(), serviceConnet);
	serviceConnet = 2341;
	printf(refb serviceStr.ToBytes(), serviceConnet);

	int aboba = 5;
	provider.WriteConnType(loc aboba);
	printf(refb serviceStr.ToBytes(), aboba);
	
	aboba = -15;
	printf(refb serviceStr.ToBytes(), aboba + 10);

	bool valera = 1 == 1;

	if(aboba == -150)
	{
		printf(refb serviceStr.ToBytes(), 777);
	}

	int val1 = 1;
	int val2 = 2;
	refb int val3 = loc val1;

	val3 = 4;
	printf(refb serviceStr.ToBytes(), val1);
	printf(refb serviceStr.ToBytes(), val2);

	refb val3 = loc val2;
	val3 = 5;
	printf(refb serviceStr.ToBytes(), val1);
	printf(refb serviceStr.ToBytes(), val2);

	Connect connTest(500);
	connTest.ConnType = 500;
	connTest.SetConnectType(10);
	connTest.PrintConnectType();

	refb byte[6] globalStrTets = "aboba";

	printf(refb globalStrTets);

	ref File file = new File(refb "popa.txt", refb "w");
	file.Write(refb globalStrTets, 4);

	byte test = 1;
	int test2 = test + 10;
	printf(refb serviceStr.ToBytes(), test2);

	return 0;
}

int main()
{
	Tests();

	return 0;
}