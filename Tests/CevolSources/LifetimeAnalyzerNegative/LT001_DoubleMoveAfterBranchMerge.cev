namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;

	public ctor(int objectNum)
	{
		refo Data = new Structure(300);
		ObjectNum = objectNum;
	}
}

void TakeOwner(refo TestObj obj)
{
	obj.ObjectNum = obj.ObjectNum + 1;
}

void Test(refo TestObj outsideObj)
{
	int num = 0;

	refo TestObj obj = new TestObj(2);

	if (num == 1)
	{
		// В if-ветке владение obj ушло в TakeOwner => obj деинициализирована.
		TakeOwner(refo obj);
	}
	else
	{
		// Переназначение obj в else-ветке не «оживляет» obj после merge.
		refo obj = new TestObj(3);
	}

	// obj деинициализирована в if-ветке, значит недоступна и после условия,
	// даже несмотря на переназначение в else.
	TakeOwner(refo obj); // LT001

	printf(ref "%d\n", outsideObj.ObjectNum);
}

int main()
{
	Test(new TestObj(1));

	return 0;
}