namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;
	public ref Structure BorrowData;

	public ctor(refo Structure data, int objectNum, ref Structure borrowData) lifetimes (data ~ this, borrowData ~ this)
	{
		refo Data = data;
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}

	public ctor(int objectNum, ref Structure borrowData) lifetimes (borrowData ~ this)
	{
		refo Data = new Structure(300);
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void Test(refo TestObj outsideObj)
{
	int num = 0;

	refo Structure structureOne = new Structure(21);
	refo Structure strcRec;
	refo Structure strcRecToBorrow = new Structure(57);

	refo TestObj obj = new TestObj(new Structure(2), 2, ref strcRecToBorrow);

	if (num == 1)
	{
		// '<-' перевёл владение structureOne в obj.Data и деинициализировал источник.
		refo strcRec = obj.Data <- structureOne;
		printf(ref "num is 1\n");
	}
	else
	{
		printf(ref "num is not 1\n");
	}

	printf(ref "%d\n", outsideObj.ObjectNum);

	// Деинициализация в if-ветке распространяется на всё условие:
	// structureOne недоступна и после if/else.
	structureOne.Num = 7; // LT001
}

int main()
{
	refo Structure seed = new Structure(0);
	Test(new TestObj(1, ref seed));

	return 0;
}