namespace Program;

extern infargs int printf(ref byte ptr);

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

int main()
{
	// Правило 5: владение перешло от a к b при реуказании владеющей ссылки.
	refo Box a = new Box(1);
	refo Box b;
	refo b = a;
	a.V = 2; // LT001: a деинициализирована после переноса владения

	return 0;
}