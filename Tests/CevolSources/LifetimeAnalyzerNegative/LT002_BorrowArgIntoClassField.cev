namespace Program;

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

class Holder
{
	public ref Box F = f;

	public ctor(ref Box f) lifetimes(f ~ this)
	{
		ref F = f;
	}

	public void Put(ref Box b)
	{
		// Правило 8: ref-параметр (как и this) считается живущим «бесконечно долго».
		// Такой ref нельзя назначать в поле класса: ссылка может пережить объект.
		ref F = b; // LT002
	}
}

int main()
{
	refo Box baseBox = new Box(0);
	refo Holder h = new Holder(ref baseBox);
	refo Box o = new Box(1);
	h.Put(ref o);

	return 0;
}