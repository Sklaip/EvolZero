namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class Holder
{
	public refo Structure Data;

	// Пустая секция lifetimes возвращает НЕ null, а пустой список (ParseLifetimesDecl),
	// поэтому автогенерация 'data ~ this' для конструктора отключается (MembersTableBuilder).
	// Без связи лайфтайм аргумента короче this, и поле его принять не может.
	public ctor(refo Structure data) lifetimes ()
	{
		refo Data = data; // LT002
	}
}

int main()
{
	refo Structure outer = new Structure(1);
	refo Holder holder = new Holder(refo outer);

	return 0;
}
