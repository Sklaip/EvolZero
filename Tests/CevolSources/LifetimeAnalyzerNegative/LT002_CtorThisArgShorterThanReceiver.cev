namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class Holder
{
	public refo Structure Data;

	public ctor(refo Structure data) lifetimes (data ~ this)
	{
		refo Data = data;
	}
}

int main()
{
	// Граница правила для '~ this' в конструкторе: receiver (this) принадлежит
	// переменной во внешнем блоке, а передаваемое значение создаётся во внутреннем. Значение живёт короче объекта, в чьё поле оно попадёт, => LT002.
	refo Holder holder;
	if (1 == 1)
	{
		refo Structure source = new Structure(7);
		refo holder = new Holder(refo source); // LT002
	}

	return 0;
}
