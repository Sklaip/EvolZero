namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

// Связь 'source ~ return' приравнивает лайфтайм owner-аргумента к лайфтайму того
// выражения, куда запишется результат (механика та же, что для ref —
// DefinePassedArgumentLifetime возвращает лайфтайм получателя результата).
refo Structure ReturnOwner(refo Structure source) lifetimes (source ~ return)
{
	return refo source;
}

int main()
{
	// Граница правила: получатель результата объявлен во внешнем блоке и живёт
	// дольше владельца из внутреннего блока. Результат нельзя сохранять в более
	// долгоживущую ссылку => LT002 на стороне вызова.
	refo Structure test;
	if (1 == 1)
	{
		refo Structure structureOne = new Structure(2);
		refo test = ReturnOwner(refo structureOne); // LT002
	}

	return 0;
}
