namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;

	public ctor(int objectNum)
	{
		refo Data = new Structure(300);
		ObjectNum = objectNum;
	}

	public void Pin(ref TestObj external)
	{
		// ref-параметр (как и this) считается живущим «бесконечно долго», значит
		// его поля имеют лайфтайм внешнего мира. Локальный владелец s живёт короче.
		refo Structure s = new Structure(7);
		refo Structure data = external.Data <- s; // LT002
	}
}

int main()
{
	refo TestObj obj = new TestObj(1);
	refo TestObj inner = new TestObj(2);
	obj.Pin(ref inner);

	return 0;
}