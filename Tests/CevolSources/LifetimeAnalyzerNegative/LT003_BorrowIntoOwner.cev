namespace Program;

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

int main()
{
	// Правило 2: в ref можно присвоить refo, но НЕ наоборот.
	own Box s = val Box(1);    // стек-экземпляр
	ref Box b = loc s;    // ref на стек-объект (правило 3)
	refo Box r = b;         // LT003: заимствованную (ref) ссылку нельзя класть во владеющую (refo)

	return 0;
}