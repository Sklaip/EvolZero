namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

void TakeOwner(refo Structure s)
{
	s.Num = s.Num;
}

void Use(ref Structure s)
{
	// Заимствованную (ref) ссылку нельзя передавать во владеющий (refo) параметр.
	TakeOwner(refo s); // LT003
}

int main()
{
	refo Structure structure = new Structure(5);
	Use(ref structure);

	return 0;
}