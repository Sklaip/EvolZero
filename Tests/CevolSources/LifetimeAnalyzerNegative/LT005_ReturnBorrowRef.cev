namespace Program;

extern infargs int printf(ref byte ptr);

// Правило: функция может возвращать только владеющую refo. Возврат заимствованной (ref)
// ссылки запрещён — ссылка указывает на память, которая может быть освобождена.
ref int Identity(int v)
{
	// loc над значением (без квалификаторов) даёт ровно ref и не разыменовывается
	// при return; возврат заимствованной ссылки запрещён и даёт LT005.
	return loc v; // LT005
}

int main()
{
	return 0;
}