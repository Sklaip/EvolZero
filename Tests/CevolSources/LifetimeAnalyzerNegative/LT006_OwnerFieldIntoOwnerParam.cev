namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;

	public ctor(refo Structure data, int objectNum)
	{
		refo Data = data;
		ObjectNum = objectNum;
	}

	public ctor(int objectNum)
	{
		refo Data = new Structure(300);
		ObjectNum = objectNum;
	}
}

void TakeStruct(refo Structure s)
{
	printf(ref "%d\n", s.Num);
}

void Test(refo TestObj obj)
{
	// Владеющую (refo) ссылку с поля класса можно снять только через оператор '<-'.
	// Прямая передача поля во владеющий параметр оставила бы поле без владельца.
	TakeStruct(refo obj.Data); // LT004

	printf(ref "%d\n", obj.ObjectNum);
}

int main()
{
	Test(new TestObj(1));

	return 0;
}