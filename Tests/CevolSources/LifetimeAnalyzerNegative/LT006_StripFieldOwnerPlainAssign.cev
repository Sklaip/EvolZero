namespace Program;

extern infargs int printf(refb byte ptr);

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

class Holder
{
	public ref Box F;

	public ctor(int v)
	{
		ref F = new Box(v);
	}
}

int main()
{
	// Правило 2/п.: снять владеющую (ref) ссылку с поля класса можно ТОЛЬКО через '<-'.
	ref Holder holder = new Holder(1);

	ref Box r;
	ref r = holder.F; // LT006: обычное присваивание «снимает» владение с поля

	return 0;
}