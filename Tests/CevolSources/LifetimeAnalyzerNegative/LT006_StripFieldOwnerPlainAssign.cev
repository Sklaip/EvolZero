namespace Program;

extern infargs int printf(ref byte ptr);

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

class Holder
{
	public refo Box F;

	public ctor(int v)
	{
		refo F = new Box(v);
	}
}

int main()
{
	// Правило 2/п.: снять владеющую (refo) ссылку с поля класса можно ТОЛЬКО через '<-'.
	refo Holder holder = new Holder(1);

	refo Box r;
	refo r = holder.F; // LT006: обычное присваивание «снимает» владение с поля

	return 0;
}