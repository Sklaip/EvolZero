namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;
	public ref Structure BorrowData;

	public ctor(refo Structure data, int objectNum, ref Structure borrowData) lifetimes (data ~ this, borrowData ~ this)
	{
		refo Data = data;
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}

	public ctor(int objectNum, ref Structure borrowData) lifetimes (borrowData ~ this)
	{
		refo Data = new Structure(300);
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void Test(refo TestObj obj)
{
	int num = 0;

	refo Structure structureOuter = new Structure(21);

	if (num == 1)
	{
		// '<-' снимает владеющую ссылку с поля obj.Data, но только если получатель
		// живёт НЕ короче объекта, с поля которого снимается ссылка. obj живёт во
		// внешнем блоке (0), а локальный stripped рождается во внутреннем (1) => LT007.
		refo Structure stripped = obj.Data <- structureOuter; // LT007
	}

	printf(ref "%d\n", obj.ObjectNum);
}

int main()
{
	refo Structure borrow = new Structure(0);
	Test(new TestObj(1, ref borrow));

	return 0;
}