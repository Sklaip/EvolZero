namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;
	public ref Structure BorrowData;

	public ctor(int objectNum, ref Structure borrowData) lifetimes (borrowData ~ this)
	{
		refo Data = new Structure(300);
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void Test(refo TestObj outsideObj)
{
	// 'new' создаёт анонимную (временную) ссылку, живующую вместе с выражением.
	// Сохранить её можно только во владеющую (refo) ссылку, а не в заимствованную (ref).
	ref outsideObj.BorrowData = new Structure(5); // LT009

	printf(ref "%d\n", outsideObj.ObjectNum);
}

int main()
{
	refo Structure borrow = new Structure(0);
	Test(new TestObj(1, ref borrow));

	return 0;
}