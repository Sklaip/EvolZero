namespace Program;

extern infargs int printf(ref byte ptr);

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

class Holder
{
	public ref Box F;

	public ctor(ref Box f) lifetimes (f ~ this)
	{
		ref F = f;
	}
}

int Take(refo Box b)
{
	printf(ref "%d\n", b.V);
	return 0;
}

int main()
{
	// Правило 7: владеющую ссылку с алиасами (ref-поле класса) нельзя передавать как владение.
	refo Box dummy = new Box(0);
	refo Box o = new Box(5);
	refo Holder h = new Holder(ref dummy);
	ref h.F = o;          // o теперь имеет алиас в ref-поле
	Take(refo o);          // LT010: нельзя передавать владение o — алиас поля F ещё жив

	return 0;
}