namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure Data;
	public refb Structure BorrowData;

	public ctor(int objectNum, refb Structure borrowData) lifetimes (borrowData ~ this)
	{
		ref Data = new Structure(300);
		refb BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void TakeStruct(ref Structure s)
{
	printf(refb "%d\n", s.Num);
}

void Test(ref TestObj outsideObj)
{
	// structureStub получила aliас в refb-поле класса.
	ref Structure structureStub = new Structure(10);
	refb outsideObj.BorrowData = structureStub;

	// Владение нельзя переносить, пока жив алиас.
	TakeStruct(ref structureStub); // LT010

	printf(refb "%d\n", outsideObj.ObjectNum);
}

int main()
{
	ref Structure borrow = new Structure(0);
	Test(new TestObj(1, refb borrow));

	return 0;
}