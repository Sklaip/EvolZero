namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;
	public ref Structure BorrowData;

	public ctor(int objectNum, ref Structure borrowData) lifetimes (borrowData ~ this)
	{
		refo Data = new Structure(300);
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void TakeStruct(refo Structure s)
{
	printf(ref "%d\n", s.Num);
}

void Test(refo TestObj outsideObj)
{
	// structureStub получила aliас в ref-поле класса.
	refo Structure structureStub = new Structure(10);
	ref outsideObj.BorrowData = structureStub;

	// Владение нельзя переносить, пока жив алиас.
	TakeStruct(refo structureStub); // LT010

	printf(ref "%d\n", outsideObj.ObjectNum);
}

int main()
{
	refo Structure borrow = new Structure(0);
	Test(new TestObj(1, ref borrow));

	return 0;
}