namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}

	public dtor()
	{
		printf(ref "Structure dtor: ");
		printf(ref "%d\n", Num);
	}
}

class Box
{
	public ref Structure Data;

	public ctor(ref Structure data) lifetimes (data ~ this)
	{
		ref Data = data;
	}

	public void Put(ref Structure b) lifetimes (b ~ this)
	{
		ref Data = b;
	}
}

void Take(refo Structure s)
{
	printf(ref "%d\n", s.Num);
}

int main()
{
	// Правило 5.2/7: владелец, переданный в ref-аргумент, связанный с 'this',
	// делает получателя своим алиасом (поле класса хранит заимствование).
	// Пока алиас жив, владение этим владельцем передавать нельзя.
	refo Structure test = new Structure(1);
	refo Box box = new Box(ref test); // box — алиас test
	box.Put(ref test);               // тот же алиас, вторая запись в поле

	Take(refo test);                  // LT010

	return 0;
}
