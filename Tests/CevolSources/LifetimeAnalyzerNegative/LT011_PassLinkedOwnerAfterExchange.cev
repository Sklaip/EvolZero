namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;

	public ctor(int objectNum)
	{
		refo Data = new Structure(300);
		ObjectNum = objectNum;
	}
}

int Take(refo TestObj o)
{
	return o.ObjectNum;
}

int main()
{
	// '<-' снимает владение с поля и связывает поле (и его объект) с получателем
	// через LinkVars (AssingHandler: value.VarData.LinkVars(target.VarData)).
	// После этого владелец obj нельзя передавать как владение в область с другим
	// временем жизни — связанные ссылки живут по-разному (CheckLinkedVarsLifetimesError).
	refo TestObj obj = new TestObj(1);
	refo Structure s = new Structure(2);
	refo Structure rec;
	refo rec = obj.Data <- s;

	Take(refo obj); // LT011

	return 0;
}
