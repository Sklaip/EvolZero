namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;

	public ctor(int objectNum)
	{
		refo Data = new Structure(300);
		ObjectNum = objectNum;
	}
}

refo TestObj Make()
{
	// Обмен '<-' через поле связывает obj с получателем rec через LinkVars
	// (AssingHandler: value.VarData.LinkVars(target.VarData)).
	// Возвращать объект с такими связями нельзя — LT012.
	refo TestObj obj = new TestObj(1);
	refo Structure s = new Structure(2);
	refo Structure rec;
	refo rec = obj.Data <- s;

	return refo obj; // LT012
}

int main()
{
	refo TestObj obj = Make();

	return 0;
}
