namespace Program;

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure BorrowData;

	public ctor(int objectNum, ref Structure borrowData) lifetimes (borrowData ~ this)
	{
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

refo TestObj ReturnObjWithUnlinkedBorrow(ref Structure structureOne)
{
	// Запись ref-аргумента в ref-поле создаёт алиас-цепочку:
	// SetAliase поднимается по Parent, поэтому obj тоже считается алиасом
	// аргумента (obj.IsAliaseTo = [structureOne]).
	// Лайфтайм ref-параметра (ForRefbArgument) короче лайфтайма return,
	// поэтому возвращать obj нельзя — LT013.
	refo Structure structureToBorrow = new Structure(20);
	refo TestObj obj = new TestObj(1, ref structureToBorrow);
	ref obj.BorrowData = structureOne;

	return refo obj; // LT013
}

int main()
{
	refo Structure source = new Structure(10);
	refo TestObj obj = ReturnObjWithUnlinkedBorrow(ref source);

	return 0;
}
