namespace Program;

extern infargs int printf(ref byte ptr);
extern infargs int scanf(ref byte ptr);

class CounterCore
{
	public int Seed;
	public int Id;

	public ctor(int seed, int id)
	{
		Seed = seed;
		Id = id;
	}

	public void Next()
	{
		Seed = Seed + 1;
	}

	public dtor()
	{
		printf(ref "\n");
		printf(ref "CounterCore destructor. Id: ");
		printf(ref "%d\n", Id);
		printf(ref "CounterCore destructor. Seed: ");
		printf(ref "%d\n", Seed);
		printf(ref "\n");
	}
}

class Counter
{
	public int Count = 5;
	public ref CounterCore Core;
	public int Id;

	public ctor(ref CounterCore core, int id) lifetimes(core ~ this)
	{
		ref Core = core;
		Id = id;
	}

	public void Increase(int num)
	{
		Core.Next();
		Count = Count + num * Core.Seed;
	}

	public dtor()
	{
		printf(ref "\n");
		printf(ref "Counter destructor. Id: ");
		printf(ref "%d\n", Id);
		printf(ref "Counter destructor. Count: ");
		printf(ref "%d\n", Count);
		printf(ref "\n");
	}
}

void Took(refo Counter obj)
{

}

int main()
{
	int inputNum = 0;
    scanf(ref "%d", loc inputNum);

	refo CounterCore baseCounterCore = new CounterCore(inputNum + 5, 1);
	refo Counter counter = new Counter(ref baseCounterCore, 1);
	
	int i = 0;
	while (i < inputNum)
	{
		if (i > 3)
		{
			refo counter = new Counter(ref baseCounterCore, i);
		} 
		
		if (i > 5)
		{
			baseCounterCore.Next();

			refo CounterCore tempCounterCore = new CounterCore(0, i * 20);
			refo Counter tempCounter = new Counter(ref tempCounterCore, i * 20);

			Took(refo tempCounter);

			baseCounterCore.Next();

			printf(ref "tempCounter Seed: ");
			printf(ref "%d\n", tempCounterCore.Seed);
		}

		counter.Increase(i);

		printf(ref "Count: ");
		printf(ref "%d\n", counter.Count);

		i = i + 1;
	}

	printf(ref "EXIT Count: ");
	printf(ref "%d\n", counter.Count);


	return 0;
}