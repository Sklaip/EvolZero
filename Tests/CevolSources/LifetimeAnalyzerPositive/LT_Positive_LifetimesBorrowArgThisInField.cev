namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}

	public dtor()
	{
		printf(refb "Structure dtor: ");
		printf(refb "%d\n", Num);
	}
}

class Box
{
	public refb Structure Data;

	public ctor(refb Structure data) lifetimes (data ~ this)
	{
		refb Data = data;
	}

	// Без связи 'b ~ this' refb-параметр живёт «бесконечно долго» и назначать
	// его в поле нельзя (LT002). Связь приравнивает лайфтайм параметра к this,
	// и присваивание в refb-поле проходит.
	public void Put(refb Structure b) lifetimes (b ~ this)
	{
		refb Data = b;
	}

	public int Num()
	{
		return Data.Num;
	}
}

int main()
{
	// Значение того же внешнего блока, что и receiver: box и source живут
	// одинаково долго, поэтому вызов с 'b ~ this' допустим.
	ref Structure sourceBase = new Structure(1);
	ref Structure source = new Structure(7);
	ref Box box = new Box(refb sourceBase);
	box.Put(refb source);
	printf(refb "%d\n", box.Num());

	// Поле — алиас исходного объекта: запись через него видна снаружи.
	refb Structure alias = box.Data;
	alias.Num = 8;
	printf(refb "%d\n", source.Num);

	return 0;
}
