namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}

	public dtor()
	{
		printf(ref "Structure dtor: ");
		printf(ref "%d\n", Num);
	}
}

class Box
{
	public ref Structure Data;

	public ctor(ref Structure data) lifetimes (data ~ this)
	{
		ref Data = data;
	}

	// Без связи 'b ~ this' ref-параметр живёт «бесконечно долго» и назначать
	// его в поле нельзя (LT002). Связь приравнивает лайфтайм параметра к this,
	// и присваивание в ref-поле проходит.
	public void Put(ref Structure b) lifetimes (b ~ this)
	{
		ref Data = b;
	}

	public int Num()
	{
		return Data.Num;
	}
}

int main()
{
	// Значение того же внешнего блока, что и receiver: box и source живут
	// одинаково долго, поэтому вызов с 'b ~ this' допустим.
	refo Structure sourceBase = new Structure(1);
	refo Structure source = new Structure(7);
	refo Box box = new Box(ref sourceBase);
	box.Put(ref source);
	printf(ref "%d\n", box.Num());

	// Поле — алиас исходного объекта: запись через него видна снаружи.
	ref Structure alias = box.Data;
	alias.Num = 8;
	printf(ref "%d\n", source.Num);

	return 0;
}
