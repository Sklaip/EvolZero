namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class Box
{
	public ref Structure Pinned;

	public ctor(ref Structure pinned) lifetimes (pinned ~ this)
	{
		ref Pinned = pinned;
	}

	// Несколько связей в одной секции: 'b ~ this' разрешает класть b в поле,
	// 'a ~ return' разрешает возвращать a как ref.
	public ref Structure Pin(ref Structure b, ref Structure a) lifetimes (b ~ this, a ~ return)
	{
		ref Pinned = b;
		return ref a;
	}
}

int main()
{
	// Оба источника живут не короче box: вызов с '~ this'/'~ return' допустим.
	refo Structure zero = new Structure(0);
	refo Structure one = new Structure(1);
	refo Structure two = new Structure(2);

	refo Box box = new Box(ref zero);

	ref Structure returned = box.Pin(ref one, ref two);

	// b ~ this: поле — алиас one.
	printf(ref "%d\n", box.Pinned.Num);
	// a ~ return: результат — алиас two.
	printf(ref "%d\n", returned.Num);

	return 0;
}
