namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class Holder
{
	public refo Structure Data;

	// Без секции lifetimes конструктор получает автогенерированную связь
	// 'data ~ this' для каждого owner-refo аргумента (MembersTableBuilder):
	// владелец, переданный в конструктор, может лечь в поле this.
	public ctor(refo Structure data)
	{
		refo Data = data;
	}
}

class BorrowHolder
{
	public ref Structure BorrowData;

	// Явная секция дублирует автогенерируемую — поведение то же.
	public ctor(ref Structure data) lifetimes (data ~ this)
	{
		ref BorrowData = data;
	}

	public int Num()
	{
		return BorrowData.Num;
	}
}

int main()
{
	// Автогенерированная связь: владелец переезжает в поле, объект читает поле.
	refo Structure outer = new Structure(11);
	refo Holder holder = new Holder(refo outer);
	printf(ref "%d\n", holder.Data.Num);

	// Явная связь data ~ this: ref-поле ссылается на живой объект внешнего блока.
	refo Structure source = new Structure(22);
	refo BorrowHolder bh = new BorrowHolder(ref source);
	printf(ref "%d\n", bh.Num());

	// BorrowData — алиас source: запись через поле видна исходному объекту.
	ref Structure alias = bh.BorrowData;
	alias.Num = 33;
	printf(ref "%d\n", source.Num);

	return 0;
}
