namespace Program;

extern infargs int printf(ref byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public refo Structure Data;
	public ref Structure BorrowData;

	public ctor(int objectNum, ref Structure borrowData) lifetimes (borrowData ~ this)
	{
		refo Data = new Structure(300);
		ref BorrowData = borrowData;
		ObjectNum = objectNum;
	}

	public int Sum()
	{
		return Data.Num + BorrowData.Num;
	}
}

// Связь 'structureOne ~ return' приравнивает лайфтайм ref-аргумента к return.
// Этого достаточно, чтобы положить аргумент в ref-поле возвращаемого объекта:
// алиас-цепочка поля не короче лайфтайма возвращаемого значения (правило LT013).
refo TestObj ReturnObjWithBorrowField(ref Structure structureOne) lifetimes (structureOne ~ return)
{
	refo TestObj obj = new TestObj(2, ref structureOne);
	return refo obj;
}

int main()
{
	// Источник и получатель результата в одном блоке — вызов допустим.
	refo Structure structure = new Structure(11);
	refo TestObj obj = ReturnObjWithBorrowField(ref structure);

	// Возвращённый объект читает и своё поле, и заимствованный источник.
	printf(ref "%d\n", obj.Sum());

	// BorrowData — алиас structure: запись через поле видна источнику.
	ref Structure alias = obj.BorrowData;
	alias.Num = 12;
	printf(ref "%d\n", structure.Num);

	return 0;
}
