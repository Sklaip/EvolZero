namespace Program;

extern infargs int printf(ref byte ptr);

class Cell
{
	public int Value;

	public ctor(int value)
	{
		Value = value;
	}

	// Без 'return ~ this' возврат ref-поля дал бы LT005 (поле живёт, пока жив this).
	// Связь приравнивает лайфтайм возвращаемого значения к this.
	public ref int GetRef() lifetimes (return ~ this)
	{
		return loc Value;
	}
}

int main()
{
	own Cell cell = val Cell(10);

	// Возвращённая ref — алиас поля: запись через неё видна объекту.
	ref int r = cell.GetRef();
	printf(ref "%d\n", cell.Value);

	r = 42;
	printf(ref "%d\n", cell.Value);

	return 0;
}
