namespace Program;

extern infargs int printf(ref byte ptr);

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

int TakeBorrow(ref Box b)
{
	printf(ref "%d\n", b.V);
	return 0;
}

int main()
{
	// Правило 3: loc всегда возвращает ref со временем жизни объекта.
	// ВАЖНО: прямое продвижение refo -> ref в компиляторе не реализовано, поэтому
	// заимствование выражается оператором loc над стек-значением (без квалификаторов).
	own Box s = val Box(10);      // стек-экземпляр
	ref Box b = loc s;       // правило 3: loc -> ref с временем жизни объекта s

	// Правило 5: передача ссылки как заимствованной НЕ передаёт владение —
	// объект жив, и к s можно продолжать обращаться после вызова.
	TakeBorrow(loc s);
	printf(ref "%d\n", s.V);  // объект не был освобождён заимствованием

	ref int r = loc s.V;
	printf(ref "%d\n", r);

	return 0;
}