namespace Program;

extern infargs int printf(ref byte ptr);

class Cell
{
	public int Value;

	public ctor(int value)
	{
		Value = value;
	}

	public ref int GetRef() lifetimes (return ~ this)
	{
		return loc Value;
	}
}

int Increment(ref int x)
{
	x = x + 1;
	return 0;
}

int main()
{
	// 1. Стек-переменная, чтение через refo.
	int a = 42;
	ref int ra = loc a;
	printf(ref "%d\n", ra);

	// 2. Запись через refo изменяет исходную переменную.
	ra = 7;
	printf(ref "%d\n", a);
	printf(ref "%d\n", ra);

	// 3. Переуказание refo на другую переменную.
	int b = 100;
	ref ra = loc b;
	ra = 5;
	printf(ref "%d\n", a);
	printf(ref "%d\n", b);

	// 4. Стек-экземпляр класса, чтение поля через refo-переменную.
	own Cell cell = val Cell(10);
	ref int rc = loc cell.Value;
	printf(ref "%d\n", rc);

	// 5. Изменение поля класса через refo-переменную.
	rc = 50;
	printf(ref "%d\n", cell.Value);

	// 6. Heap-экземпляр, чтение поля через refo.
	refo Cell heapCell = new Cell(20);
	ref int rhc = loc heapCell.Value;
	printf(ref "%d\n", rhc);

	// 7. Метод, возвращающий refo на поле.
	ref int fromMethod = cell.GetRef();
	printf(ref "%d\n", cell.Value);
	fromMethod = 77;
	printf(ref "%d\n", cell.Value);

	// 8. Передача refo-параметра функции, мутация вызывающей переменной.
	int c = 5;
	Increment(loc c);
	Increment(loc c);
	printf(ref "%d\n", c);

	return 0;
}
