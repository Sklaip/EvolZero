namespace Program;

extern infargs int printf(refb byte ptr);

class Inner
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}

	public void AddNum(int amount)
	{
		Num = Num + amount;
	}
}

class Middle
{
	public refb Inner Child;

	public ctor(refb Inner child) lifetimes (child ~ this)
	{
		refb Child = child;
	}

	public refb Inner GetChild() lifetimes (return ~ this)
	{
		return refb Child;
	}
}

class Outer
{
	public refb Middle Mid;

	public ctor(refb Middle mid) lifetimes (mid ~ this)
	{
		refb Mid = mid;
	}
}

int main()
{
	// 1. Цепочка ref-полей: чтение вглубь.
	ref Inner inner = new Inner(5);
	ref Middle mid = new Middle(refb inner);
	ref Outer outer = new Outer(refb mid);

	printf(refb "%d\n", outer.Mid.Child.Num);

	// 2. Мутация через цепочку ref-полей.
	outer.Mid.Child.Num = 25;
	printf(refb "%d\n", inner.Num);
	printf(refb "%d\n", outer.Mid.Child.Num);

	// 3. Вызов метода через цепочку ref-полей.
	outer.Mid.Child.AddNum(10);
	printf(refb "%d\n", inner.Num);

	// 4. ref-поле хранит ту же ссылку -> два пути к одному объекту.
	outer.Mid.Child.Num = 33;
	printf(refb "%d\n", inner.Num);
	printf(refb "%d\n", mid.Child.Num);
	printf(refb "%d\n", outer.Mid.Child.Num);

	// 5. Метод, возвращающий ref-поле -> дальнейшая мутация.
	refb Inner viaMethod = outer.Mid.GetChild();
	viaMethod.Num = 40;
	printf(refb "%d\n", inner.Num);

	// 6. Переуказание ref-поля в цепочке.
	ref Inner second = new Inner(111);
	refb mid.Child = second;
	printf(refb "%d\n", outer.Mid.Child.Num);
	printf(refb "%d\n", inner.Num);

	return 0;
}
