namespace Program;

extern infargs int printf(ref byte ptr);

class Inner
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}

	public void AddNum(int amount)
	{
		Num = Num + amount;
	}
}

class Middle
{
	public ref Inner Child;

	public ctor(ref Inner child) lifetimes (child ~ this)
	{
		ref Child = child;
	}

	public ref Inner GetChild() lifetimes (return ~ this)
	{
		return ref Child;
	}
}

class Outer
{
	public ref Middle Mid;

	public ctor(ref Middle mid) lifetimes (mid ~ this)
	{
		ref Mid = mid;
	}
}

int main()
{
	// 1. Цепочка refo-полей: чтение вглубь.
	refo Inner inner = new Inner(5);
	refo Middle mid = new Middle(ref inner);
	refo Outer outer = new Outer(ref mid);

	printf(ref "%d\n", outer.Mid.Child.Num);

	// 2. Мутация через цепочку refo-полей.
	outer.Mid.Child.Num = 25;
	printf(ref "%d\n", inner.Num);
	printf(ref "%d\n", outer.Mid.Child.Num);

	// 3. Вызов метода через цепочку refo-полей.
	outer.Mid.Child.AddNum(10);
	printf(ref "%d\n", inner.Num);

	// 4. refo-поле хранит ту же ссылку -> два пути к одному объекту.
	outer.Mid.Child.Num = 33;
	printf(ref "%d\n", inner.Num);
	printf(ref "%d\n", mid.Child.Num);
	printf(ref "%d\n", outer.Mid.Child.Num);

	// 5. Метод, возвращающий refo-поле -> дальнейшая мутация.
	ref Inner viaMethod = outer.Mid.GetChild();
	viaMethod.Num = 40;
	printf(ref "%d\n", inner.Num);

	// 6. Переуказание refo-поля в цепочке.
	refo Inner second = new Inner(111);
	ref mid.Child = second;
	printf(ref "%d\n", outer.Mid.Child.Num);
	printf(ref "%d\n", inner.Num);

	return 0;
}
