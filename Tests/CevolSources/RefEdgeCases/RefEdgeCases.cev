namespace Program;

extern infargs int printf(refb byte ptr);

class Conn
{
	public int Type;

	public ctor(int type)
	{
		Type = type;
	}
}

int Swap(refb int x, refb int y)
{
	int tmp = x;
	x = y;
	y = tmp;
	return 0;
}

int main()
{
	// 1. Псевдонимирование: две ссылки на одну переменную.
	int a = 10;
	refb int r1 = loc a;
	refb int r2 = loc a;
	r1 = 5;
	printf(refb "%d\n", r2);
	printf(refb "%d\n", a);

	// 2. Значение, переданное по ссылке, читается внутри функции.
	int b = 100;
	int c = 200;
	Swap(loc b, loc c);
	printf(refb "%d\n", b);
	printf(refb "%d\n", c);

	// 3. Переуказание ссылки между чтениями (два независимых адреса).
	int p = 1;
	int q = 2;
	refb int rp = loc p;
	rp = rp + 10;
	printf(refb "%d\n", p);
	refb rp = loc q;
	rp = rp + 20;
	printf(refb "%d\n", p);
	printf(refb "%d\n", q);

	// 4. Ссылка на поле объекта, затем переуказание на поле другого объекта.
	Conn c1(7);
	Conn c2(9);
	refb int rc = loc c1.Type;
	rc = 70;
	printf(refb "%d\n", c1.Type);
	refb rc = loc c2.Type;
	rc = 90;
	printf(refb "%d\n", c1.Type);
	printf(refb "%d\n", c2.Type);

	// 5. Чтение полей через ссылки с одинаковым базовым адресом.
	int arr0 = 1;
	int arr1 = 2;
	refb int ra0 = loc arr0;
	refb int ra1 = loc arr1;
	ra0 = ra0 + ra1;
	printf(refb "%d\n", arr0);

	// 6. Ссылка, возвращённая методом/выражением, остаётся валидной.
	ref Conn obj = new Conn(30);
	refb int ro = loc obj.Type;
	ro = ro + 5;
	printf(refb "%d\n", obj.Type);

	return 0;
}
