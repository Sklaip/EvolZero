namespace Program;

extern infargs int printf(ref byte ptr);

class TestObj
{
	public int X;

	public ctor(int x)
	{
		X = x;
	}
}

refo TestObj CreateTestObj()
{
	refo TestObj a = new TestObj(42);
	return refo a;
}

int main()
{
	refo TestObj r = CreateTestObj();
	printf(ref "%d\n", r.X);

	r.X = r.X + 1;
	printf(ref "%d\n", r.X);

	return 0;
}