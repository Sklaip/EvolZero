namespace Program;

extern infargs int printf(ref byte ptr);

class TestObj
{
	public int Value;

	public ctor(int value)
	{
		Value = value;
	}
}

int PassRef(refo TestObj b)
{
	return 0;
}

int main()
{
	refo TestObj a = new TestObj(1);
	refo TestObj b = new TestObj(2);
	refo TestObj c = new TestObj(3);

	// b деинициализируется в любой ветке if/else, поэтому после блока к ней
	// обращаться нельзя: использование b ниже должно дать ошибку компиляции.
	if (1 == 1)
	{
		refo a = b;
	}
	else
	{
		PassRef(refo b);
	}

	refo TestObj x = b;

	printf(ref "%d\n", x.Value);
	return 0;
}