namespace Program;

extern infargs int printf(refb byte ptr);
extern infargs int scanf(refb byte ptr);

int main()
{
	int n = 0;
	// Читаем число из консоли. Вход управляет всеми ветвлениями.
	// Чтобы покрыть каждую ветку if/else if/else, подаются разные числа:
	//   0 -> a=1 (if взята),    b=2 (else),   c=10 (первый else if)
	//   1 -> a=0 (if не взята), b=1 (if),     c=20 (второй else if)
	//   2 -> a=0,               b=2,          c=30 (третий else if)
	//   3 -> a=0,               b=2,          c=40 (конечный else)

	// Чтение числа из консоли.
	scanf(ref "%d", loc n);

	int a = 0;
	if (n == 0)
	{
		a = 1;
	}
	printf(ref "%d\n", a);

	int b = 0;
	if (n == 1)
	{
		b = 1;
	}
	else
	{
		b = 2;
	}
	printf(ref "%d\n", b);

	int c = 0;
	if (n == 0)
	{
		c = 10;
	}
	else if (n == 1)
	{
		c = 20;
	}
	else if (n == 2)
	{
		c = 30;
	}
	else
	{
		c = 40;
	}
	printf(ref "%d\n", c);

	return 0;
}