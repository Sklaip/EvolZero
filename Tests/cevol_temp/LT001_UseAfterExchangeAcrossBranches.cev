namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure Data;
	public refb Structure BorrowData;

	public ctor(ref Structure data, int objectNum, refb Structure borrowData) lifetimes (data ~ this, borrowData ~ this)
	{
		ref Data = data;
		refb BorrowData = borrowData;
		ObjectNum = objectNum;
	}

	public ctor(int objectNum, refb Structure borrowData) lifetimes (borrowData ~ this)
	{
		ref Data = new Structure(300);
		refb BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void Test(ref TestObj outsideObj)
{
	int num = 0;

	ref Structure structureOne = new Structure(21);
	ref Structure strcRec;
	ref Structure strcRecToBorrow = new Structure(57);

	ref TestObj obj = new TestObj(new Structure(2), 2, ref strcRecToBorrow);

	if (num == 1)
	{
		// '<-' перевёл владение structureOne в obj.Data и деинициализировал источник.
		ref strcRec = obj.Data <- structureOne;
		printf(ref "num is 1\n");
	}
	else
	{
		printf(ref "num is not 1\n");
	}

	printf(ref "%d\n", outsideObj.ObjectNum);

	// Деинициализация в if-ветке распространяется на всё условие:
	// structureOne недоступна и после if/else.
	structureOne.Num = 7; // LT001
}

int main()
{
	ref Structure seed = new Structure(0);
	Test(new TestObj(1, ref seed));

	return 0;
}