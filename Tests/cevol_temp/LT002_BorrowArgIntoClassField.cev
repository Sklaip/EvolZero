namespace Program;

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

class Holder
{
	public refb Box F = f;

	public ctor(refb Box f) lifetimes(f ~ this)
	{
		ref F = f;
	}

	public void Put(refb Box b)
	{
		// Правило 8: refb-параметр (как и this) считается живущим «бесконечно долго».
		// Такой refb нельзя назначать в поле класса: ссылка может пережить объект.
		ref F = b; // LT002
	}
}

int main()
{
	ref Box baseBox = new Box(0);
	ref Holder h = new Holder(ref baseBox);
	ref Box o = new Box(1);
	h.Put(ref o);

	return 0;
}