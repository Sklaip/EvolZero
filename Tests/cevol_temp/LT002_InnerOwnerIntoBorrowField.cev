namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure Data;
	public refb Structure BorrowData;

	public ctor(int objectNum)
	{
		ref Data = new Structure(300);
		ObjectNum = objectNum;
	}
}

void Test(ref TestObj obj)
{
	// Внутренний блок if: inner живёт только в нём, а поле obj.BorrowData имеет
	// лайфтайм объекта obj (внешний блок) => класть inner туда нельзя.
	if (1 == 1)
	{
		ref Structure inner = new Structure(9);
		refb obj.BorrowData = inner; // LT002
	}

	printf(ref "%d\n", obj.ObjectNum);
}

int main()
{
	Test(ref new TestObj(1));

	return 0;
}