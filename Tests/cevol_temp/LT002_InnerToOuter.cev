namespace Program;

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

int main()
{
	// Правило 4: чем ниже лайфтайм (номер блока), тем дольше живёт переменная.
	// Нельзя присваивать в более долгоживущую ссылку объект, живущий во внутреннем блоке.
	// ВАЖНО: сырые {}-блоки компилятор пока флаттит (скоупы не моделируются), поэтому
	// настоящая внутренняя область создаётся блоком if (true).
	ref Box a = new Box(0);
	if (1 == 1)
	{
		ref Box t = new Box(1);
		ref a = t; // LT002: t (внутренний блок) живёт меньше, чем a (внешний)
	}

	return 0;
}