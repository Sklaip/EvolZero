namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure Data;

	public ctor(ref Structure data, int objectNum)
	{
		ref Data = data;
		ObjectNum = objectNum;
	}

	public ctor(int objectNum)
	{
		ref Data = new Structure(300);
		ObjectNum = objectNum;
	}
}

void TakeStruct(ref Structure s)
{
	printf(ref "%d\n", s.Num);
}

void Test(ref TestObj obj)
{
	// Владеющую (ref) ссылку с поля класса можно снять только через оператор '<-'.
	// Прямая передача поля во владеющий параметр оставила бы поле без владельца.
	TakeStruct(ref obj.Data); // LT004

	printf(ref "%d\n", obj.ObjectNum);
}

int main()
{
	Test(ref new TestObj(1));

	return 0;
}