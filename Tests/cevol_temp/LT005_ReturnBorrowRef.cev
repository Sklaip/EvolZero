namespace Program;

extern infargs int printf(refb byte ptr);

// Правило: функция может возвращать только владеющую ref. Возврат заимствованной (refb)
// ссылки запрещён — ссылка указывает на память, которая может быть освобождена.
refb int Identity(int v)
{
	// loc над значением (без квалификаторов) даёт ровно refb и не разыменовывается
	// при return; возврат заимствованной ссылки запрещён и даёт LT005.
	return loc v; // LT005
}

int main()
{
	return 0;
}