namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure Data;
	public refb Structure BorrowData;

	public ctor(ref Structure data, int objectNum, refb Structure borrowData) lifetimes (data ~ this, borrowData ~ this)
	{
		ref Data = data;
		refb BorrowData = borrowData;
		ObjectNum = objectNum;
	}

	public ctor(int objectNum, refb Structure borrowData) lifetimes (borrowData ~ this)
	{
		ref Data = new Structure(300);
		refb BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void Test(ref TestObj obj)
{
	int num = 0;

	ref Structure structureOuter = new Structure(21);

	if (num == 1)
	{
		// '<-' снимает владеющую ссылку с поля obj.Data, но только если получатель
		// живёт НЕ короче объекта, с поля которого снимается ссылка. obj живёт во
		// внешнем блоке (0), а локальный stripped рождается во внутреннем (1) => LT007.
		ref Structure stripped = obj.Data <- structureOuter; // LT007
	}

	printf(ref "%d\n", obj.ObjectNum);
}

int main()
{
	ref Structure borrow = new Structure(0);
	Test(new TestObj(1, ref borrow));

	return 0;
}