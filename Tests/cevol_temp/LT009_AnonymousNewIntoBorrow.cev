namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class TestObj
{
	public int ObjectNum;
	public ref Structure Data;
	public refb Structure BorrowData;

	public ctor(int objectNum, refb Structure borrowData) lifetimes (borrowData ~ this)
	{
		ref Data = new Structure(300);
		refb BorrowData = borrowData;
		ObjectNum = objectNum;
	}
}

void Test(ref TestObj outsideObj)
{
	// 'new' создаёт анонимную (временную) ссылку, живующую вместе с выражением.
	// Сохранить её можно только во владеющую (ref) ссылку, а не в заимствованную (refb).
	refb outsideObj.BorrowData = new Structure(5); // LT009

	printf(ref "%d\n", outsideObj.ObjectNum);
}

int main()
{
	ref Structure borrow = new Structure(0);
	Test(ref new TestObj(1, ref borrow));

	return 0;
}