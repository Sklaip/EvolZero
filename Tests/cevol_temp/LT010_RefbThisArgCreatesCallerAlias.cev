namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}

	public dtor()
	{
		printf(ref "Structure dtor: ");
		printf(ref "%d\n", Num);
	}
}

class Box
{
	public refb Structure Data;

	public ctor(refb Structure data) lifetimes (data ~ this)
	{
		refb Data = data;
	}

	public void Put(refb Structure b) lifetimes (b ~ this)
	{
		refb Data = b;
	}
}

void Take(ref Structure s)
{
	printf(ref "%d\n", s.Num);
}

int main()
{
	// Правило 5.2/7: владелец, переданный в refb-аргумент, связанный с 'this',
	// делает получателя своим алиасом (поле класса хранит заимствование).
	// Пока алиас жив, владение этим владельцем передавать нельзя.
	ref Structure test = new Structure(1);
	ref Box box = new Box(ref test); // box — алиас test
	box.Put(ref test);               // тот же алиас, вторая запись в поле

	Take(ref test);                  // LT010

	return 0;
}
