namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

class Box
{
	public refb Structure Pinned;

	public ctor(refb Structure pinned) lifetimes (pinned ~ this)
	{
		refb Pinned = pinned;
	}

	// Несколько связей в одной секции: 'b ~ this' разрешает класть b в поле,
	// 'a ~ return' разрешает возвращать a как refb.
	public refb Structure Pin(refb Structure b, refb Structure a) lifetimes (b ~ this, a ~ return)
	{
		refb Pinned = b;
		return ref a;
	}
}

int main()
{
	// Оба источника живут не короче box: вызов с '~ this'/'~ return' допустим.
	ref Structure zero = new Structure(0);
	ref Structure one = new Structure(1);
	ref Structure two = new Structure(2);

	ref Box box = new Box(ref zero);

	refb Structure returned = box.Pin(ref one, ref two);

	// b ~ this: поле — алиас one.
	printf(ref "%d\n", box.Pinned.Num);
	// a ~ return: результат — алиас two.
	printf(ref "%d\n", returned.Num);

	return 0;
}
