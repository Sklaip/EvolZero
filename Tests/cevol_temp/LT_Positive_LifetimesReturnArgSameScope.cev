namespace Program;

extern infargs int printf(refb byte ptr);

class Structure
{
	public int Num;

	public ctor(int num)
	{
		Num = num;
	}
}

// Связь 'source ~ return' разрешает возвращать заимствованную ссылку:
// лайфтайм источника приравнен к лайфтайму возвращаемого значения (правило 7.5).
refb Structure ReturnRefb(refb Structure source) lifetimes (source ~ return)
{
	return refb source;
}

int main()
{
	// Источник и получатель результата в одном блоке: вызов допустим (нет LT002).
	ref Structure structureOne = new Structure(5);
	refb Structure result = ReturnRefb(refb structureOne);

	// result — алиас structureOne: запись через результат видна источнику.
	printf(refb "%d\n", result.Num);
	result.Num = 6;
	printf(refb "%d\n", structureOne.Num);

	return 0;
}
