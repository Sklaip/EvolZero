namespace Program;

extern infargs int printf(refb byte ptr);

class Cell
{
	public int Value;

	public ctor(int value)
	{
		Value = value;
	}

	// Без 'return ~ this' возврат refb-поля дал бы LT005 (поле живёт, пока жив this).
	// Связь приравнивает лайфтайм возвращаемого значения к this.
	public refb int GetRef() lifetimes (return ~ this)
	{
		return loc Value;
	}
}

int main()
{
	Cell cell(10);

	// Возвращённая refb — алиас поля: запись через неё видна объекту.
	refb int r = cell.GetRef();
	printf(refb "%d\n", cell.Value);

	r = 42;
	printf(refb "%d\n", cell.Value);

	return 0;
}
