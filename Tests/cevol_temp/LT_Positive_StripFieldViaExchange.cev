namespace Program;

extern infargs int printf(refb byte ptr);

class Box
{
	public int V;

	public ctor(int v)
	{
		V = v;
	}
}

class Holder
{
	public ref Box F;

	// Поле инициализируется в конструкторе; снаружи его можно менять только через '<-'
	// (оператор обмена), чтобы старый владелец не пропал бесследно.
	public ctor(int v)
	{
		ref F = new Box(v);
	}
}

int main()
{
	// Снятие владеющей ссылки с поля разрешено ТОЛЬКО через '<-' (иначе LT006).
	// o2 объявлен раньше holder, чтобы обмен не попал под LT002 (значение старше поля).
	ref Box o2 = new Box(2);
	ref Holder holder = new Holder(1);

	// Старый объект (1) переезжает из поля в r, поле получает o2. Ни один объект не должен
	// быть удалён раньше времени: printf(r.V) прочитал бы мусор, если бы o1 освободили.
	ref Box r;
	ref r = holder.F <- o2;
	printf(ref "%d\n", r.V);          // 1
	printf(ref "%d\n", holder.F.V);   // 2

	return 0;
}