namespace Program;

extern infargs int printf(refb byte ptr);
extern infargs int scanf(refb byte ptr);

int main()
{
	int n = 0;
	// далее читаем n из консоли:
	scanf(ref "%d", loc n);

	// 1. двойной цикл: сумма произведений i*j по всем i,j в 1..n
	int total = 0;
	int a = 1;
	while (a < n + 1)
	{
		int b = 1;
		while (b < n + 1)
		{
			total = total + a * b;
			b = b + 1;
		}
		a = a + 1;
	}
	printf(ref "%d\n", total);

	// 2. двойной цикл по счётчикам 0..n-1: всего итераций n*n
	int runs = 0;
	int x = 0;
	while (x < n)
	{
		int y = 0;
		while (y < n)
		{
			runs = runs + 1;
			y = y + 1;
		}
		x = x + 1;
	}
	printf(ref "%d\n", runs);

	// 3. тройной цикл: всего итераций n*n*n
	int triple = 0;
	int i = 0;
	while (i < n)
	{
		int j = 0;
		while (j < n)
		{
			int k = 0;
			while (k < n)
			{
				triple = triple + 1;
				k = k + 1;
			}
			j = j + 1;
		}
		i = i + 1;
	}
	printf(ref "%d\n", triple);

	// 4. внутренний цикл с убывающим счётчиком: acc = сумма (1+...+m) для m=1..n
	int acc = 0;
	int m = 1;
	while (m < n + 1)
	{
		int v = m;
		while (v > 0)
		{
			acc = acc + v;
			v = v - 1;
		}
		m = m + 1;
	}
	printf(ref "%d\n", acc);

	// 5. пары q<p: всего n*(n+1)/2
	int pairs = 0;
	int p = 1;
	while (p < n + 1)
	{
		int q = 0;
		while (q < p)
		{
			pairs = pairs + 1;
			q = q + 1;
		}
		p = p + 1;
	}
	printf(ref "%d\n", pairs);

	return 0;
}